# Configuration for docker-compose.prod.yml. Copy to .env and edit:
#
#   cp .env.example .env

# The origin players reach the app at, with scheme and no trailing slash. It has
# two jobs: it builds the address Slack returns players to after they sign in,
# and it sets the backend's CORS allowlist. Must be https -- Slack refuses to
# redirect to a plain http address, so sign-in could never complete.
PUBLIC_ORIGIN=https://insertyourdomainhere.com

# Signing in with Slack. Create an app at https://api.slack.com/apps with
# "Sign in with Slack" enabled and the openid, profile and email scopes, then add
# https://insertyourdomainhere.com/auth/slack/callback as a Redirect URL.
#
# The server will not start without these: signing in is the only way to play, so
# a deployment missing them could not serve anyone.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# The one workspace allowed to sign in, e.g. T01ABCDEFGH. Find it in the URL when
# you open Slack in a browser. Anyone from another workspace is turned away.
SLACK_TEAM_ID=

# How long a sign-in lasts. Optional; defaults to 30 days.
# SESSION_TTL_HOURS=720

# Where the stack listens for the reverse proxy. If the proxy runs on this same
# host, set WEB_BIND=127.0.0.1 so nothing is reachable without going through it.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# Postgres credentials. The password is interpolated into a URL, so avoid the
# characters @ : / ? # in it.
POSTGRES_USER=secret
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secrethitler
